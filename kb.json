    },
    {
        "id": 1,
        "name": "getUnifiedCropDataNic",
        "description": "Fetches unified crop data (staging quantity , estimated quantity, intake, processed, tested, pass/fail quantity, production of a crop etc.) for a specified **stateName**, **year**, and **season**. This endpoint also supports filtering the results further by optional parameters such as **cropName** , **varietyName** ,** blockName**and **districtName**.",
        "endpoint": "https://seedtrace.gov.in/api/sainet/getUnifiedCropDataNic",
        "params": {
            "stateName": "<StateName>",
            "year": "<YearRange>",
            "season": "<SeasonName>",
            "cropName": "<OptionalCropName>",
            "varietyName": "<OptionalVarietyName>",
            "districtName": "<OptionalDistrictName>",
            "blockName": "<OptionalBlockName>"
        },
        "response": {
            "successdata": "array_of_objects"
        },
        "example_url": "https://seedtrace.gov.in/api/sainet/getUnifiedCropDataNic?year=2024-25&stateName=Rajasthan&season=Rabi",
        "tags": ["crop", "data", "season", "state", "report", "filter"],
        "preExicutionRequriedApi": []
    },
